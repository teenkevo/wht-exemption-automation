# Copy to .env for local development. Process environment variables win over this file.
# local reads data/delta/wht_base_v1. remote joins the seven lake tables and saves that table.
WHT_MODE=local
# When WHT_MODE=remote, this replaces the /data/lakehouse prefix and reads Delta files.
# Leave it empty on the lake machine so remote mode uses config/drill.yaml.
WHT_LAKE_ROOT=/data/lakehouse
# Drill account for the lake machine. The password is never stored in the repository.
DRILL_USER=
DRILL_PASSWORD=
# Path to drill-jdbc-all-1.22.0.jar. Overrides the jar path in config/drill.yaml.
DRILL_JDBC_JAR=
# The run date picks the checklist cycle. Set WHT_AS_OF=YYYY-MM-DD to rerun an
# earlier date, or WHT_CYCLE=wht_2026_27_h1 to name a cycle directly.
WHT_AS_OF=
WHT_CYCLE=
# Leave empty to use this directory.
PIPELINE_ROOT=
LOG_LEVEL=INFO
