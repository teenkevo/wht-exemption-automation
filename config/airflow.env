PIPELINE_ROOT=/opt/wht-exemption-automation
WHT_MODE=remote
# Remote reads the lake through Drill. Set DRILL_USER, DRILL_PASSWORD, and
# DRILL_JDBC_JAR in the environment. WHT_LAKE_ACCESS=file reads Delta at the
# remote_sources paths instead.
PYTHONPATH=/opt/wht-exemption-automation/src:/opt/wht-exemption-automation
